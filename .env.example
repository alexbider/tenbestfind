# Local development. Copy to .env; the deploy passes the same names as the
# Docker project's environment rather than reading this file.

DATABASE_URL="file:./prisma/dev.db"
SESSION_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Where uploads are written and how they are served back.
MEDIA_DIR=""
MEDIA_PUBLIC_PATH="/uploads"

# The admin account the seed creates. Set both before seeding, or the seed
# generates a password and prints it once.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Stripe. Leave blank to run without payments: the flows still record intent
# and the admin still works, but checkout is skipped.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Quote request email. Leave blank to store the request without sending it.
# The admin holds an encrypted copy of the key; this wins when both are set.
RESEND_API_KEY=""
MAIL_FROM=""

# The importer. Same rule: the admin holds encrypted copies and these win.
APIFY_TOKEN=""
ANTHROPIC_API_KEY=""
IMPORT_MODEL=""
IMPORT_EFFORT="medium"
